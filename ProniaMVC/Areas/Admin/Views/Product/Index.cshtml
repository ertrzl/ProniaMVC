@model List<Product>

@{
    int count = 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Products</h4>
                    <a href="/Admin/Product/Create" class="btn btn-success">Create</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    No
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Price
                                </th>
                                <th>
                                    Category
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Product product in Model)
                            {
                                var primaryImage = product.ProductImages.FirstOrDefault(pi => pi.IsPrimary == true)?.Image;
                                <tr>
                                    <td>
                                        @count
                                    </td>
                                    <td class="py-1">
                                        <img src="~/assets/images/website-images/@primaryImage" alt="@product.Name" />
                                    </td>
                                    <td>
                                        @product.Name
                                    </td>
                                    <td>
                                        $@product.Price
                                    </td>
                                    <td>
                                        @product.Category.Name
                                    </td>
                                    <td>
                                        <a class="btn btn-warning"><i class="mdi mdi-pen"></i></a>
                                        <a class="btn btn-danger"><i class="mdi mdi-delete"></i></a>
                                        <a href="/Admin/Product/Details/@product.Id" class="btn btn-primary"><i class="mdi mdi-open-in-new"></i></a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
