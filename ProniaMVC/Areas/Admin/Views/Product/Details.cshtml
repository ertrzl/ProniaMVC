@model Product

<div class="row">
    <div class="col-lg-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Product Details</h4>
                    <a href="/Admin/Product/Index" class="btn btn-sm btn-secondary">Back to list</a>
                </div>

                <div class="mb-4 d-flex flex-wrap">
                    @foreach (ProductImage image in Model.ProductImages)
                    {
                        <img src="~/assets/images/website-images/@image.Image" alt="@Model.Name" class="img-fluid rounded me-2 mb-2" style="max-height:150px;" />
                    }
                </div>

                <table class="table">
                    <tbody>
                        <tr>
                            <th style="width:180px;">Id</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>$@Model.Price</td>
                        </tr>
                        <tr>
                            <th>SKU</th>
                            <td>@Model.SKU</td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>@Model.Category.Name</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>
                        <tr>
                            <th>Created At</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
