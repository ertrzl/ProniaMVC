@model Category

<div class="row">
    <div class="col-lg-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Category Details</h4>
                    <a href="/Admin/Category/Index" class="btn btn-sm btn-secondary">Back to list</a>
                </div>

                <table class="table">
                    <tbody>
                        <tr>
                            <th style="width:180px;">Id</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Created At</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
