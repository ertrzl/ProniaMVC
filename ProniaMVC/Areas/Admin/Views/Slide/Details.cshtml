@model Slide

<div class="row">
    <div class="col-lg-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Slide Details</h4>
                    <a href="/Admin/Slide/Index" class="btn btn-sm btn-secondary">Back to list</a>
                </div>

                <div class="mb-4">
                    <img src="~/assets/images/website-images/@Model.Image" alt="@Model.Title" class="img-fluid rounded" style="max-height:300px;" />
                </div>

                <table class="table">
                    <tbody>
                        <tr>
                            <th style="width:180px;">Id</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Title</th>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <th>SubTitle</th>
                            <td>@Model.SubTitle</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>
                        <tr>
                            <th>Order</th>
                            <td>@Model.Order</td>
                        </tr>
                        <tr>
                            <th>Image</th>
                            <td>@Model.Image</td>
                        </tr>
                        <tr>
                            <th>Created At</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
